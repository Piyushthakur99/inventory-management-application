# Copy this file to: backend/openai.secrets.properties
# Then fill in your OpenAI API key once.
# This file is git-ignored.

# Enable OpenAI integration
openai.enabled=true

# Your OpenAI API key (keep it private)
openai.api-key=

# Model
openai.model=gpt-4.1-mini

# Optional overrides
# openai.base-url=https://api.openai.com/v1
# openai.timeout-seconds=20
